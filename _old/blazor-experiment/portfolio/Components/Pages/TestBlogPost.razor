@page "/blog/{slug}"

<PageTitle>@GetPostTitle() - Kyle Blank Rollins</PageTitle>

<article class="blog-post">
  <header class="post-header">
    <h1>@GetPostTitle()</h1>
    <div class="post-meta">
      <time datetime="@GetPostDate()">@GetFormattedDate()</time>
      <span class="reading-time">@GetReadingTime() min read</span>
    </div>
  </header>

  <div class="post-content">
    @if (Slug == "semantic-html-css")
    {
      <p>
        It's funny how things circle around. The first iterations of my
        portfolio site were 100% vanilla HTML, CSS, and JavaScript. Then it
        was VuePress, a static site generator that uses Vue.js. And then it
        was Vue CLI and Tailwind CSS.
      </p>
      <p>
        This version? A return to semantic HTML and modern CSS with a Blazor backend.
        Sometimes the best solution is to embrace web fundamentals with contemporary techniques.
      </p>
      <h2>Why Semantic HTML Matters</h2>
      <p>
        Semantic HTML provides meaning and structure that benefits both users and developers.
        It improves accessibility, SEO, and maintainability while reducing complexity.
      </p>
      <h2>Modern CSS Features</h2>
      <p>
        With CSS custom properties, nesting, container queries, and grid, we can create
        sophisticated layouts and components without JavaScript frameworks.
      </p>
    }
    else if (Slug == "technical-writing-evolution")
    {
      <p>
        Technical writing has evolved dramatically with the rise of agile development,
        DevOps practices, and the docs-as-code movement. Today's technical writers
        need to be part developer, part designer, and part user experience expert.
      </p>
      <h2>Key Skills for Modern Technical Writers</h2>
      <ul>
        <li>Version control (Git)</li>
        <li>Markup languages (Markdown, HTML)</li>
        <li>Basic programming concepts</li>
        <li>User experience principles</li>
        <li>Information architecture</li>
      </ul>
    }
    else
    {
      <p>Blog post not found.</p>
    }
  </div>

  <footer class="post-footer">
    <nav class="post-navigation">
      @if (GetPreviousPost() != null)
      {
        <a href="/blog/@GetPreviousPost()"
           class="nav-previous">← @GetPreviousPostTitle()</a>
      }
      @if (GetNextPost() != null)
      {
        <a href="/blog/@GetNextPost()"
           class="nav-next">@GetNextPostTitle() →</a>
      }
    </nav>

    <div class="post-actions">
      <a href="/blog"
         class="back-to-blog">← Back to Blog</a>
    </div>
  </footer>
</article>

@code {
  [Parameter] public string Slug { get; set; } = "";

  private string GetPostTitle()
  {
    return Slug switch
    {
      "semantic-html-css" => "Returning to Semantic HTML and CSS",
      "technical-writing-evolution" => "The Evolution of Technical Writing",
      _ => "Post Not Found"
    };
  }

  private string GetPostDate()
  {
    return Slug switch
    {
      "semantic-html-css" => "2024-01-15",
      "technical-writing-evolution" => "2024-01-01",
      _ => DateTime.Now.ToString("yyyy-MM-dd")
    };
  }

  private string GetFormattedDate()
  {
    return Slug switch
    {
      "semantic-html-css" => "January 15, 2024",
      "technical-writing-evolution" => "January 1, 2024",
      _ => DateTime.Now.ToString("MMMM d, yyyy")
    };
  }

  private string GetReadingTime()
  {
    return Slug switch
    {
      "semantic-html-css" => "5",
      "technical-writing-evolution" => "3",
      _ => "1"
    };
  }

  private string? GetPreviousPost()
  {
    return Slug switch
    {
      "semantic-html-css" => "technical-writing-evolution",
      _ => null
    };
  }

  private string? GetNextPost()
  {
    return Slug switch
    {
      "technical-writing-evolution" => "semantic-html-css",
      _ => null
    };
  }

  private string GetPreviousPostTitle()
  {
    return GetPreviousPost() switch
    {
      "technical-writing-evolution" => "The Evolution of Technical Writing",
      _ => ""
    };
  }

  private string GetNextPostTitle()
  {
    return GetNextPost() switch
    {
      "semantic-html-css" => "Returning to Semantic HTML and CSS",
      _ => ""
    };
  }
}