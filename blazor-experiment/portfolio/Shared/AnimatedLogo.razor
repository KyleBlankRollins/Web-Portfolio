@namespace portfolio.Components.Shared
@implements IDisposable

<div class="animated-logo">
  <div class="logo-container @(IsTransitioning ? "transitioning" : "")">
    <div class="underscore-container">
      <!-- Top row: K [empty] R -->
      <span class="logo-k @(IsExpanded ? "expanded" : "")">K</span>
      <div class="middle-space"></div>
      <span class="logo-r @(IsExpanded ? "expanded" : "")">R</span>

      <!-- Bottom row: [empty] _ [empty] (underscore spans 1 or 3 columns) -->
      <div class="left-space"></div>
      <div class="underscore @(IsExpanded ? "expanded" : "")"
           data-role="@CurrentRole">
        <svg width="100"
             height="20"
             viewBox="0 0 100 20"
             xmlns="http://www.w3.org/2000/svg">
          <rect y="15"
                width="100%"
                height="4"
                rx="2"
                fill="currentColor" />
        </svg>
      </div>
      <div class="right-space"></div>

      <!-- Role text overlay -->
      <div class="role-text @(IsExpanded ? "visible" : "")">@CurrentRole</div>
    </div>
  </div>
</div>

@code {
  private string[] Roles = { "Technical Writer", "Developer", "Designer", "Team Lead" };
  private int currentRoleIndex = 0;
  private bool IsExpanded = false;
  private bool IsTransitioning = false;
  private Timer? animationTimer;

  private string CurrentRole => Roles[currentRoleIndex];

  protected override void OnInitialized()
  {
    StartAnimation();
  }

  private void StartAnimation()
  {
    Console.WriteLine("Starting logo animation");
    // Start the animation cycle with initial delay
    animationTimer = new Timer(async _ =>
    {
      await InvokeAsync(async () =>
  {
    // Start transition
      IsTransitioning = true;
      StateHasChanged();

    // Step 1: Expand underscore and show role
      IsExpanded = true;
      StateHasChanged();

    // Wait for expansion animation (2 seconds to see the role)
      await Task.Delay(2000);

    // Step 2: Contract and return to K_R
      IsExpanded = false;
      StateHasChanged();

    // Wait for contraction animation (800ms)
      await Task.Delay(800);

    // End transition effect
      IsTransitioning = false;

    // Move to next role
      currentRoleIndex = (currentRoleIndex + 1) % Roles.Length;
      StateHasChanged();
    });
    }, null, TimeSpan.FromMilliseconds(1000), TimeSpan.FromMilliseconds(4500)); // Total cycle: 4.5 seconds with 1s initial
  }

  public void Dispose()
  {
    animationTimer?.Dispose();
  }
}