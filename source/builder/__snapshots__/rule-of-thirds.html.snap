    <!-- Theme bootstrap - see the matching comment in base.html. Blocking on
         purpose so [data-theme] and [data-color-scheme] exist before first
         paint. Mirrors loadSavedTheme() in theme-switcher.ts; keep in sync. -->
    <script>
      (function () {
        var d = document.documentElement;
        try {
          d.setAttribute(
            "data-theme",
            localStorage.getItem("kbr-theme") || "base"
          );
          d.setAttribute(
            "data-color-scheme",
            localStorage.getItem("kbr-color-scheme") ||
              (window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light")
          );
        } catch (e) {
          d.setAttribute("data-theme", "base");
          d.setAttribute("data-color-scheme", "light");
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>The P&amp;G Rule of Thirds</title>
    
    <meta name="description" content="How to adapt Sid Meier&#39;s Rule of Thirds to professional development and goal setting" />
     
    <meta name="keywords" content="professional growth, goal setting, rule of thirds" />
     
