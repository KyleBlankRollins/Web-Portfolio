<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Theme bootstrap. Blocking on purpose, and kept first in <head>.

         The gradient behind every page comes from --gradient-primary, which
         only exists inside [data-theme="base"] and [data-theme="canney-valley"].
         Those attributes used to be stamped by theme-switcher.ts in
         connectedCallback - after the Lit bundle parses - so the page painted
         once with the properties.css fallbacks and then visibly repainted.

         This mirrors loadSavedTheme() in theme-switcher.ts exactly: same
         storage keys, same "base" default, same matchMedia fallback. The
         component reads the same values afterwards and re-applies them, which
         is a no-op. Keep the two in sync. See DF-13. -->
    <script>
      (function () {
        var d = document.documentElement;
        try {
          d.setAttribute(
            "data-theme",
            localStorage.getItem("kbr-theme") || "base"
          );
          d.setAttribute(
            "data-color-scheme",
            localStorage.getItem("kbr-color-scheme") ||
              (window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light")
          );
        } catch (e) {
          // localStorage throws in private mode with cookies disabled.
          d.setAttribute("data-theme", "base");
          d.setAttribute("data-color-scheme", "light");
        }
      })();
    </script>
    <!-- Root-absolute so it resolves from nested paths such as
         /<post>/supplements/<page>.html as well as from the site root. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Theme System Demo</title>
    
    <meta name="description" content="Demonstration of the theme system with live switching capabilities" />
     
    <meta name="keywords" content="theme, design system, accessibility, dark mode" />
     
      <link rel="stylesheet" crossorigin href="/assets/index-HASH.css">
</head>

  <body>
    <kbr-navigation>
      <!-- Slotted into .header-content so the switcher sits at the far right
           of the site header. It used to be a fixed-position floating control,
           which overlapped page content at every viewport width. See DF-31. -->
      <kbr-theme-switcher slot="theme-switcher"></kbr-theme-switcher>
    </kbr-navigation>

    <main class="page-content"><section>
  <h1>Theme System</h1>
  <p class="lead">
    Experience the powerful theme system with accessible color schemes and
    smooth transitions between light and dark modes.
  </p>
</section>

<section>
  <h2>Available Themes</h2>

  <div class="grid two-columns">
    <article class="card">
      <h3>Basic Blue</h3>
      <p>
        Clean, professional theme built on a deep blue, over cool grey surfaces.
        Designed for maximum accessibility and readability.
      </p>
      <ul>
        <li>WCAG AA compliant contrast ratios</li>
        <li>Professional aesthetic</li>
        <li>Works in any context</li>
      </ul>
    </article>

    <article class="card">
      <h3>Canney Valley</h3>
      <p>
        Nature-inspired theme featuring forest greens, warm purples, and deep
        slate colors from the original Canney Valley design.
      </p>
      <ul>
        <li>Organic color palette</li>
        <li>Creative and artistic feel</li>
        <li>Gradient support</li>
      </ul>
    </article>
  </div>
</section>

<section>
  <h2>Theme Features</h2>

  <div class="grid three-columns">
    <div class="feature-card">
      <h3>🌓 Light & Dark Modes</h3>
      <p>
        Every theme includes carefully crafted light and dark variants with
        proper contrast ratios for accessibility.
      </p>
    </div>

    <div class="feature-card">
      <h3>♿ Accessibility First</h3>
      <p>
        All themes meet WCAG AA standards with support for reduced motion and
        high contrast preferences.
      </p>
    </div>

    <div class="feature-card">
      <h3>💾 Persistent Preferences</h3>
      <p>
        Your theme and color scheme choices are saved and restored across
        sessions using localStorage.
      </p>
    </div>
  </div>
</section>

<section>
  <h2>Color System</h2>
  <p>
    The theme system uses semantic color tokens that adapt based on the selected
    theme and color scheme.
  </p>

  <div class="color-showcase">
    <div class="color-group">
      <h3>Primary Colors</h3>
      <div class="color-swatches">
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-primary)"
          ></div>
          <span class="swatch-label">Primary</span>
        </div>
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-primary-hover)"
          ></div>
          <span class="swatch-label">Hover</span>
        </div>
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-primary-active)"
          ></div>
          <span class="swatch-label">Active</span>
        </div>
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-primary-subtle)"
          ></div>
          <span class="swatch-label">Subtle</span>
        </div>
      </div>
    </div>

    <div class="color-group">
      <h3>Accent Colors</h3>
      <div class="color-swatches">
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-accent)"
          ></div>
          <span class="swatch-label">Accent</span>
        </div>
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-accent-hover)"
          ></div>
          <span class="swatch-label">Hover</span>
        </div>
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-accent-active)"
          ></div>
          <span class="swatch-label">Active</span>
        </div>
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-accent-subtle)"
          ></div>
          <span class="swatch-label">Subtle</span>
        </div>
      </div>
    </div>

    <div class="color-group">
      <h3>Semantic Colors</h3>
      <div class="color-swatches">
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-success)"
          ></div>
          <span class="swatch-label">Success</span>
        </div>
        <div class="color-swatch">
          <div
            class="swatch-chip"
            style="background: var(--color-warning)"
          ></div>
          <span class="swatch-label">Warning</span>
        </div>
        <div class="color-swatch">
          <div class="swatch-chip" style="background: var(--color-error)"></div>
          <span class="swatch-label">Error</span>
        </div>
        <div class="color-swatch">
          <div class="swatch-chip" style="background: var(--color-info)"></div>
          <span class="swatch-label">Info</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <h2>Interactive Elements</h2>
  <p>Test how different UI elements look and feel in each theme:</p>

  <div class="demo-elements">
    <div class="button-demo">
      <h3>Buttons</h3>
      <button class="btn btn-primary">Primary</button>
      <button class="btn btn-secondary">Secondary</button>
      <button class="btn btn-ghost">Ghost</button>
    </div>

    <div class="form-demo">
      <h3>Form Elements</h3>
      <input type="text" placeholder="Sample input field" />
      <textarea placeholder="Sample textarea"></textarea>
      <select>
        <option>Sample dropdown</option>
        <option>Option 2</option>
        <option>Option 3</option>
      </select>
    </div>

    <div class="card-demo">
      <h3>Cards</h3>
      <div class="sample-card card">
        <h4>Sample Card</h4>
        <p>This card demonstrates how content looks within the theme system.</p>
        <a href="#" class="card-link">Learn More →</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Light-DOM button classes.

     .btn and its variants are defined in styles/shared-styles.ts, which is
     only ever adopted into component shadow roots - so on this page, which is
     plain light DOM, the markup below picked up nothing but the bare `button`
     rule in style.css. The declarations here mirror shared-styles.ts; keep
     them in step if that file changes.

     They live on this page rather than in style.css because this is the only
     light-DOM consumer of .btn on the site. Promoting them to the global
     sheet would ship rules nothing else matches.

     Variants shown are the ones the design system actually defines. The page
     previously also rendered .btn-accent and .btn-success, which exist in no
     stylesheet at all - inventing them here would be adding to the design
     system through its own demo page. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.2777778rem;
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    user-select: none;
  }

  .btn:focus {
    outline: var(--focus-ring-width) var(--focus-ring-style)
      var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .btn-primary {
    background-color: var(--color-on-surface);
    color: var(--color-text-inverse);
    border-color: var(--color-on-surface);
  }

  .btn-primary:hover {
    background-color: var(--color-on-surface-hover);
    border-color: var(--color-on-surface-hover);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .btn-secondary:hover {
    background-color: var(--color-background-secondary);
    border-color: var(--color-on-surface);
    color: var(--color-on-surface);
  }

  .btn-ghost {
    background-color: transparent;
    color: var(--color-text);
    border-color: transparent;
  }

  .btn-ghost:hover {
    background-color: var(--color-background-secondary);
    color: var(--color-on-surface);
  }

  .color-showcase {
    display: grid;
    gap: var(--space-lg);
    margin: var(--space-lg) 0;
  }

  .color-group h3 {
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
  }

  .color-swatches {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* The label sits under the chip rather than on it.

     It used to be `color: white` inside the coloured block, with two swatches
     opting back out to --color-text. That cannot work here: this page exists
     to display arbitrary token values, including light ones - white on
     --color-primary (#e2e8f0 in the base theme) is about 1.1:1 - and every
     new token would need someone to judge its luminance by hand. Below the
     chip the label is on the page background, so it is readable for any
     colour the swatch happens to hold. */
  .color-swatch {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100px;
  }

  .swatch-chip {
    height: 60px;
    border-radius: var(--radius);
    border: 1px solid var(--color-border-secondary);
  }

  .swatch-label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    text-align: center;
  }

  .demo-elements {
    display: grid;
    gap: var(--space-lg);
    margin: var(--space-lg) 0;
  }

  .demo-elements > div {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .button-demo {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    align-items: center;
  }

  .button-demo h3 {
    width: 100%;
    margin: 0 0 var(--space-sm) 0;
  }

  .form-demo {
    display: grid;
    gap: var(--space-sm);
  }

  .form-demo input,
  .form-demo textarea,
  .form-demo select {
    padding: var(--input-padding-y) var(--input-padding-x);
    border: var(--input-border-width) solid var(--color-border);
    border-radius: var(--input-border-radius);
    background: var(--color-background);
    color: var(--color-text);
    font-family: inherit;
  }

  .form-demo input:focus,
  .form-demo textarea:focus,
  .form-demo select:focus {
    outline: var(--focus-ring-width) var(--focus-ring-style)
      var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .sample-card {
    margin: 0;
  }

  .card-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .card-link:hover {
    color: var(--color-accent-hover);
  }

  .feature-card {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .feature-card h3 {
    margin: 0 0 var(--space-sm) 0;
    font-size: var(--font-size-lg);
  }

  @media (max-width: 768px) {
    .color-swatches {
      justify-content: center;
    }

    .color-swatch {
      width: 80px;
      height: 50px;
      font-size: var(--font-size-xs);
    }
  }
</style>
</main>

    <!-- Shared markup from templates/partials/footer.html, injected by
         template-processor.ts. Edit the partial, not this line. -->
    <!--
  Shared site footer.

  This is the single source of the footer markup. It is injected into both
  base.html and blog-post.html as the {&lt;!--
  Shared site footer.

  This is the single source of the footer markup. It is injected into both
  base.html and blog-post.html as the  template variable, wired up
  in source/builder/template-processor.ts - which is the one choke point both
  the production build and the dev server render through. Do not paste this
  markup into a template; add the variable instead, or every page type grows
  its own copy.

  Light DOM on purpose, not a Lit component: the footer has to be present in
  the generated HTML for crawlers and for readers without JavaScript, and a
  shadow root would leave only an empty custom element in the static output.
--&gt;
&lt;footer class=&quot;site-footer&quot;&gt;
  &lt;nav class=&quot;site-footer-nav&quot; aria-label=&quot;Elsewhere on the web&quot;&gt;
    &lt;ul&gt;
      &lt;li&gt;
        &lt;a
          href=&quot;https://www.linkedin.com/in/kyle-blank-rollins/&quot;
          target=&quot;_blank&quot;
          rel=&quot;noopener noreferrer&quot;
          &gt;LinkedIn&lt;/a
        &gt;
      &lt;/li&gt;
      &lt;li&gt;
        &lt;a
          href=&quot;https://github.com/KyleBlankRollins/Web-Portfolio&quot;
          target=&quot;_blank&quot;
          rel=&quot;noopener noreferrer&quot;
          &gt;GitHub&lt;/a
        &gt;
      &lt;/li&gt;
    &lt;/ul&gt;
  &lt;/nav&gt;
&lt;/footer&gt;} template variable, wired up
  in source/builder/template-processor.ts - which is the one choke point both
  the production build and the dev server render through. Do not paste this
  markup into a template; add the variable instead, or every page type grows
  its own copy.

  Light DOM on purpose, not a Lit component: the footer has to be present in
  the generated HTML for crawlers and for readers without JavaScript, and a
  shadow root would leave only an empty custom element in the static output.
-->
<footer class="site-footer">
  <nav class="site-footer-nav" aria-label="Elsewhere on the web">
    <ul>
      <li>
        <a
          href="https://www.linkedin.com/in/kyle-blank-rollins/"
          target="_blank"
          rel="noopener noreferrer"
          >LinkedIn</a
        >
      </li>
      <li>
        <a
          href="https://github.com/KyleBlankRollins/Web-Portfolio"
          target="_blank"
          rel="noopener noreferrer"
          >GitHub</a
        >
      </li>
    </ul>
  </nav>
</footer>
      <script type="module" crossorigin src="/assets/index-HASH.js"></script>
    <script type="module" crossorigin src="/assets/lit-HASH.js"></script>
</body>
</html>
