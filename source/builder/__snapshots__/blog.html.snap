<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Theme bootstrap. Blocking on purpose, and kept first in <head>.

     The gradient behind every page comes from --gradient-primary, which
     only exists inside [data-theme="base"] and [data-theme="canney-valley"].
     Those attributes used to be stamped by theme-switcher.ts in
     connectedCallback - after the Lit bundle parses - so the page painted
     once with the properties.css fallbacks and then visibly repainted.

     This mirrors THEME_STORAGE_KEY, COLOR_SCHEME_STORAGE_KEY, and
     DEFAULT_THEME in theme-constants.ts, as well as loadSavedTheme() in
     theme-switcher.ts. Keep the literals and constants in sync. See DF-13. -->
<script>
  (function () {
    var d = document.documentElement;
    try {
      d.setAttribute("data-theme", localStorage.getItem("kbr-theme") || "base");
      d.setAttribute(
        "data-color-scheme",
        localStorage.getItem("kbr-color-scheme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light")
      );
    } catch (e) {
      // localStorage throws in private mode with cookies disabled.
      d.setAttribute("data-theme", "base");
      d.setAttribute("data-color-scheme", "light");
    }
  })();
</script>
<!-- Root-absolute so it resolves from nested paths such as
     /<post>/supplements/<page>.html as well as from the site root. -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>Blog - Kyle Blank Rollins</title>

<meta name="description" content="Thoughts on technical writing, web development, and professional insights." />
 
<meta name="keywords" content="blog, technical writing, web development, Kyle Blank Rollins" />
 
      <link rel="stylesheet" crossorigin href="/assets/index-HASH.css">
</head>

  <body>
    <kbr-navigation>
  <!-- Slotted into .header-content so the switcher sits at the far right
       of the site header. It used to be a fixed-position floating control,
       which overlapped page content at every viewport width. See DF-31. -->
  <kbr-theme-switcher slot="theme-switcher"></kbr-theme-switcher>
</kbr-navigation>

    <main class="page-content"><section class="blog-content">
  <div class="blog-layout">
    <aside class="blog-sidebar">
      <kbr-tag-filter></kbr-tag-filter>
    </aside>
    <div class="blog-posts">
      <kbr-post-list></kbr-post-list>
    </div>
  </div>
</section>
</main>

    <!-- Shared markup from templates/partials/footer.html, injected by
         template-processor.ts. Edit the partial, not this line. -->
    <!--
  Shared site footer.

  This is the single source of the footer markup. It is injected into both
  base.html and blog-post.html through the footer template variable, wired up
  in source/builder/template-processor.ts - which is the one choke point both
  the production build and the dev server render through. Do not paste this
  markup into a template; add the variable instead, or every page type grows
  its own copy.

  Light DOM on purpose, not a Lit component: the footer has to be present in
  the generated HTML for crawlers and for readers without JavaScript, and a
  shadow root would leave only an empty custom element in the static output.
-->
<footer class="site-footer">
  <nav class="site-footer-nav" aria-label="Elsewhere on the web">
    <ul>
      <li>
        <a
          href="https://www.linkedin.com/in/kyle-blank-rollins/"
          target="_blank"
          rel="noopener noreferrer"
          >LinkedIn</a
        >
      </li>
      <li>
        <a
          href="https://github.com/KyleBlankRollins/Web-Portfolio"
          target="_blank"
          rel="noopener noreferrer"
          >GitHub</a
        >
      </li>
    </ul>
  </nav>
</footer>
      <script type="module" crossorigin src="/assets/index-HASH.js"></script>
    <script type="module" crossorigin src="/assets/lit-HASH.js"></script>
</body>
</html>
