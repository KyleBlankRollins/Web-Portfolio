{
  "name": "kyleblankrollins-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Personal portfolio website for Kyle Blank Rollins",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:git-aware": "GIT_AWARE=true vite",
    "build": "tsc && vite build",
    "build:git-aware": "tsc && GIT_AWARE=true vite build",
    "build:force-all": "tsc && GIT_AWARE=true FORCE_ALL=true vite build",
    "build-site": "tsx source/builder/main.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "copy-component-styles": "shx cp source/site/components/*.css public/components/",
    "lint:prose": "tsx scripts/lint-prose.ts",
    "lint:prose:changed": "tsx scripts/lint-prose.ts --changed-only",
    "lint:prose:drafts": "tsx scripts/lint-prose.ts --drafts-only",
    "lint:prose:staged": "tsx scripts/lint-prose.ts --staged",
    "lint:prose:verbose": "tsx scripts/lint-prose.ts --verbose",
    "clean:public": "tsx scripts/clean-public.ts",
    "clean:public:dry-run": "tsx scripts/clean-public.ts --dry-run",
    "setup-hooks": "tsx scripts/setup-git-hooks.ts",
    "postinstall": "npm run setup-hooks"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^20.19.17",
    "glob": "^11.0.3",
    "shx": "^0.4.0",
    "tsx": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.6"
  },
  "dependencies": {
    "lit": "^3.3.1",
    "marked": "^9.0.0"
  }
}
